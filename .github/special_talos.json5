{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
      {
        "description": ["Block automerge for Kubelet and Talos version Patch"],
        "matchUpdateTypes": ["patch"],
        "automerge": false,
        "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "ghcr.io/siderolabs/talos"],
        "labels": ["type/patch", "system-upgrade"],
        "addLabels": null
      },
      {
        "description": ["Block automerge for Kubelet and Talos version Minor"],
        "matchUpdateTypes": ["minor"],
        "automerge": false,
        "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "ghcr.io/siderolabs/talos"],
        "labels": ["type/minor", "system-upgrade"],
        "addLabels": null
      },
      {
        "description": ["Block automerge for Kubelet and Talos version Major"],
        "matchUpdateTypes": ["major"],
        "automerge": false,
        "dependencyDashboardApproval": true,
        "matchPackageNames": ["ghcr.io/siderolabs/kubelet", "ghcr.io/siderolabs/talos"],
        "labels": ["type/major", "system-upgrade"],
        "addLabels": null
      },
      {
        "description": ["Block automerge for Authentik"],
        "matchUpdateTypes": ["minor","major","patch"],
        "dependencyDashboardApproval": true,
        "matchPackageNames": ["oci.trueforge.org/truecharts/authentik"],
        "labels": ["type/minor","type/major","type/patch"],
        "addLabels": null
      },
      {
        "description": ["Block automerge for Nextcloud"],
        "matchUpdateTypes": ["minor","major","patch"],
        "dependencyDashboardApproval": true,
        "matchPackageNames": ["oci.trueforge.org/truecharts/nextcloud"],
        "labels": ["type/minor","type/major","type/patch"],
        "addLabels": null
      }
    ]
  }